# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / Railway).
# Leave unset in local dev: the app falls back to an embedded PGlite
# database stored under .data/pglite (same SQL, zero setup).
# DATABASE_URL=postgres://user:pass@host:5432/pidash

# ── Cache ───────────────────────────────────────────────────────────────────
# Redis URL (Upstash for serverless). Optional — without it an in-process
# cache is used and cross-process freshness is read from Postgres.
# REDIS_URL=rediss://default:pass@host:6379

# ── Operator / admin ───────────────────────────────────────────────────────
# Bearer key for the signal-publishing API + admin UI. Generate:
#   openssl rand -hex 32
ADMIN_API_KEY=change-me-dev-only

# Secret for signing user session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-session

# ── Pi Network platform ────────────────────────────────────────────────────
# Server API key from the Pi Developer Portal (develop.pi in Pi Browser /
# minepi.com/developers). Required for auth verification + payments.
# PI_API_KEY=

# "true" while testing against the Pi sandbox environment.
NEXT_PUBLIC_PI_SANDBOX=true

# ── Product configuration ──────────────────────────────────────────────────
# free      → everything visible to everyone (recommended until Phase 5)
# freemium  → open signals + alerts require an active Pi subscription;
#             performance history & closed signals stay free (non-negotiable §3.8)
MONETIZATION_MODE=free

# Symbol is fixed for v1.
NEXT_PUBLIC_SYMBOL=PIUSDT

# Hour (UTC) at which the daily report worker generates the previous day's report.
REPORT_HOUR_UTC=0

# ── Monitoring ─────────────────────────────────────────────────────────────
# SENTRY_DSN=
