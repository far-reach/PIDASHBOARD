# ─────────────────────────────────────────────────────────────────────────────
# PiPulse configuration. Copy to .env for local development.
# Production values are set in the hosting platform's secret store — never
# commit real secrets. Every variable the codebase reads is listed here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / Railway).
# Leave unset in local dev: the app falls back to an embedded PGlite database
# under .data/pglite (same SQL, same triggers, zero setup).
# REQUIRED in production — the app refuses to start on the embedded database
# when NODE_ENV=production, because local disk is wiped on redeploy and the
# signal history would be lost.
# DATABASE_URL=postgres://user:pass@host:5432/pidash

# Deliberate opt-out of the guard above, for self-hosted deployments whose
# disk really is persistent. Leave unset unless you are sure.
# ALLOW_EMBEDDED_DB_IN_PRODUCTION=1

# Override the embedded database's directory (used by the E2E harness).
# PGLITE_DIR=.data/pglite

# ── Cache ───────────────────────────────────────────────────────────────────
# Redis URL (Upstash for serverless). Optional — without it an in-process
# cache is used and cross-process freshness is read from Postgres.
# Recommended when running more than one web instance.
# REDIS_URL=rediss://default:pass@host:6379

# ── Operator / admin ────────────────────────────────────────────────────────
# Bearer key for the signal-publishing API and the /admin console.
# Generate: openssl rand -hex 32
ADMIN_API_KEY=change-me-dev-only

# Secret for signing user session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-dev-only-session

# Bearer secret for the scheduled-job endpoints (/api/cron/*). Vercel Cron
# sends this automatically when set as CRON_SECRET. Min 16 chars.
# Only needed for serverless deployments without the always-on worker.
# CRON_SECRET=

# ── Pi Network platform ─────────────────────────────────────────────────────
# Server API key from the Pi Developer Portal (develop.pi in Pi Browser).
# Required for Pi auth verification and payments.
# PI_API_KEY=

# Domain-ownership key shown by the Developer Portal. Setting this makes
# https://<your-domain>/validation-key.txt serve it, so you can click
# "Verify domain" in the portal without redeploying code.
# PI_VALIDATION_KEY=

# "true" while testing against the Pi sandbox; set to "false" for production.
NEXT_PUBLIC_PI_SANDBOX=true

# Platform API base. Only override if the official docs change it.
# PI_API_BASE=https://api.minepi.com/v2

# ── Product configuration ───────────────────────────────────────────────────
# free      → everything visible to everyone (recommended until launch + 1 month)
# freemium  → currently-open signals and alerts require an active subscription;
#             closed history and performance stay free (non-negotiable §3.8)
MONETIZATION_MODE=free

# Trading pair. Fixed for v1.
NEXT_PUBLIC_SYMBOL=PIUSDT

# Hour (UTC) at which the daily report worker generates the previous day's
# report. The worker fires at HH:05.
REPORT_HOUR_UTC=0

# How many recent days each report run backfills, so one missed run does not
# leave a permanent hole in the archive.
# REPORT_BACKFILL_DAYS=7

# Price of the 30-day Pro subscription, in Pi. Read server-side when verifying
# that a payment covers the advertised price — a payment below it is rejected.
# Keep the NEXT_PUBLIC_ copy identical: it is only what the button displays.
PRO_PRICE_PI=1
NEXT_PUBLIC_PRO_PRICE_PI=1

# ── Tips (voluntary support) ────────────────────────────────────────────────
# A tip is a direct payment to your app wallet that unlocks NOTHING. It works in
# `free` mode as well as `freemium`, and is on unless switched off here.
# TIPS_ENABLED=false

# Accepted tip range, in Pi. The minimum blocks dust payments; the maximum
# blocks a fat-fingered amount. Both are enforced server-side against the
# amount the Pi platform reports, not the amount the browser claims.
# MIN_TIP_PI=0.1
# MAX_TIP_PI=1000

# Quick-pick amounts shown on the support card. Display only — the server
# accepts anything inside MIN/MAX, so this can be changed freely.
NEXT_PUBLIC_TIP_PRESETS=1,5,10

# ── Workers / ingestion tuning ──────────────────────────────────────────────
# INGEST_INTERVAL_MS=5000
# RESOLVE_INTERVAL_MS=10000
# SNAPSHOT_RETENTION_DAYS=14
# WORKER_LOOP=1                 # set by the worker:report:loop script

# ── Exchange endpoints (override only for testing/mocking) ──────────────────
# OKX_API_BASE=https://www.okx.com
# OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
# MEXC_API_BASE=https://api.mexc.com
# BITGET_API_BASE=https://api.bitget.com

# ── Monitoring ──────────────────────────────────────────────────────────────
# Optional. Install @sentry/nextjs and set this to forward handled errors.
# Without it, structured JSON logs still go to stdout.
# SENTRY_DSN=

# ── Seeding (development only) ──────────────────────────────────────────────
# SEED_PUBLIC=1                 # mark seeded signals public — staging demos ONLY
