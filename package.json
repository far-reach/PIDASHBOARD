{
  "name": "cyberekt",
  "version": "0.1.0",
  "private": true,
  "description": "Cyberekt Market — PIUSDT trading dashboard for the Pi Network app ecosystem: live multi-exchange price data, automated daily reports, and an immutable, honestly-tracked trading-calls feed.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:server": "PGLITE_DIR=.data/e2e-pglite ADMIN_API_KEY=test-admin-key-e2e MONETIZATION_MODE=free NEXT_PUBLIC_SIGNALS_ENABLED=true next dev -p 3100",
    "worker:ingest": "tsx workers/ingest.ts",
    "worker:report": "tsx workers/report.ts",
    "worker:resolve": "tsx workers/resolve.ts",
    "worker:report:loop": "WORKER_LOOP=1 tsx workers/report.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-test-signals.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.454.0",
    "next": "^15.1.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
